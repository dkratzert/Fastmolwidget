#!/bin/sh
#
# pre-push hook: reject pushing version tags (e.g. "version-1.5.1" or "v1.5.1")
# whose version does not match __version__ defined in
# src/fastmolwidget/__init__.py at the commit the tag points to.
#
# Git has no client-side hook that fires on local `git tag` creation, so
# this is enforced at push time instead, which is the last point before
# the tag becomes visible to others.
#
# Install (once per clone):
#   git config core.hooksPath .githooks
#
# Tag names are expected to look like "version-X.Y.Z" or "vX.Y.Z" (matching
# __version__ = 'X.Y.Z'). Tags that don't match either pattern are ignored.

INIT_FILE="src/fastmolwidget/__init__.py"
z40="0000000000000000000000000000000000000000"

reject=0

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
        refs/tags/*) ;;
        *) continue ;;
    esac

    # Tag deletion (local_sha is all zeros) - nothing to check.
    if [ "$local_sha" = "$z40" ]; then
        continue
    fi

    tag_name=${local_ref#refs/tags/}

    case "$tag_name" in
        version-*) tag_version=${tag_name#version-} ;;
        v*) tag_version=${tag_name#v} ;;
        *) continue ;;
    esac

    # Resolve to the commit the tag points at (handles annotated tags).
    commit_sha=$(git rev-list -n 1 "$local_sha" 2>/dev/null)
    if [ -z "$commit_sha" ]; then
        commit_sha="$local_sha"
    fi

    file_content=$(git show "$commit_sha:$INIT_FILE" 2>/dev/null)
    if [ -z "$file_content" ]; then
        echo "pre-push: warning: could not read $INIT_FILE at $commit_sha for tag $tag_name; skipping check" >&2
        continue
    fi

    file_version=$(printf '%s\n' "$file_content" | sed -n "s/^__version__ *= *['\"]\\([^'\"]*\\)['\"].*/\\1/p" | head -n 1)
    if [ -z "$file_version" ]; then
        echo "pre-push: warning: could not parse __version__ from $INIT_FILE at $commit_sha; skipping check" >&2
        continue
    fi

    if [ "$tag_version" != "$file_version" ]; then
        echo "pre-push: rejected: tag '$tag_name' (version $tag_version) does not match" >&2
        echo "          __version__ = '$file_version' in $INIT_FILE at commit $commit_sha." >&2
        echo "          Update $INIT_FILE to $tag_version before tagging/pushing, or fix the tag name." >&2
        reject=1
    fi
done

if [ "$reject" -eq 1 ]; then
    exit 1
fi

exit 0

